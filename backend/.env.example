APP_NAME=CDSS Backend
APP_ENV=development
DEBUG=True

POSTGRES_NAME=cdss_db
POSTGRES_PASSWORD=1234
POSTGRES_USER=postgres

DATABASE_URL=postgresql+psycopg2://postgres:1234@localhost:5432/cdss_db

SECRET_KEY=change_this_to_a_secure_random_secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

YOLO_MODEL_PATH=models/weights/best.pt
YOLO_CONFIDENCE_THRESHOLD=0.25
YOLO_IOU_THRESHOLD=0.45
YOLO_DEVICE=cpu

UPLOAD_DIR=uploads/model/
MAX_UPLOAD_SIZE=10485760